# Public operator-facing RTMP base URL. Do not include a username or password.
NEXT_PUBLIC_RTMP_BASE_URL=rtmp://3.1.11.194:1935/live

# The public viewer plays HLS through its same-origin Vercel proxy.
NEXT_PUBLIC_HLS_STREAM_URL=/api/hls/live/drone/index.m3u8

# Optional separate server-side health URL. This checks the AWS MediaMTX HLS origin directly.
STREAM_HEALTH_URL=http://3.1.11.194:8888/live/drone/index.m3u8

# Required: set this in Vercel. Do not commit the real value.
OPERATOR_PASSWORD=change-me
# Optional: use a unique random string to independently sign the operator session cookie.
OPERATOR_SESSION_SECRET=change-me-too
